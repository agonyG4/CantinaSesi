# Address the HTTP API binds to. Default: 127.0.0.1:8080
CANTINA_BIND_ADDRESS=127.0.0.1:8080

# Base URL used by HTTP clients (the CLI, future frontends) to reach the API.
# Default: http://127.0.0.1:8080
CANTINA_API_URL=http://127.0.0.1:8080

# Optional comma-separated list of allowed CORS origins.
# When unset, CORS is permissive (development only).
CANTINA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log filter for the API tracing subscriber. Default: info
RUST_LOG=info

# Server-side session timeouts in seconds.
# Idle: a session expires if unused for this long. Default: 1800 (30 min)
CANTINA_SESSION_IDLE_TTL_SECONDS=1800
# Absolute: a session expires this long after creation, regardless of activity.
# Default: 28800 (8 h). Must be >= idle; both must be > 0.
CANTINA_SESSION_ABSOLUTE_TTL_SECONDS=28800
